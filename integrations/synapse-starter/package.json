{
  "name": "synapse-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Synapse starter template \u2014 clone into Replit, paste secrets, hit Run: the app connects to Citadel, reads Noon data, and publishes events.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch server/index.ts",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "build:deploy": "npm run verify && npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "secrets": "tsx scripts/scan-secrets.ts",
    "visual": "tsx scripts/visual-check.ts",
    "job": "tsx server/jobs/run.ts",
    "sync:registry": "tsx scripts/sync-registry.ts",
    "verify": "npm run secrets && npm run typecheck && npm run lint && npm run test && npm run check:urls && npm run check:theme",
    "check:urls": "tsx scripts/check-live-urls.ts",
    "check:theme": "tsx scripts/check-theme-tokens.ts",
    "check:release": "tsx scripts/check-template-version.ts",
    "prepare": "node scripts/setup-hooks.mjs"
  },
  "dependencies": {
    "@noonacademy/citadel-transport": "file:vendor/noonacademy-citadel-transport-0.3.0.tgz",
    "@noonacademy/synapse-catalog": "file:vendor/noonacademy-synapse-catalog-0.1.1.tgz",
    "@noonacademy/synapse-sdk": "file:vendor/noonacademy-synapse-sdk-0.4.0.tgz",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "vite": "^6.0.7"
  },
  "overrides": {
    "@noonacademy/citadel-transport": "file:vendor/noonacademy-citadel-transport-0.3.0.tgz",
    "@noonacademy/synapse-catalog": "file:vendor/noonacademy-synapse-catalog-0.1.1.tgz",
    "@noonacademy/synapse-sdk": "file:vendor/noonacademy-synapse-sdk-0.4.0.tgz"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cross-env": "^7.0.3",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  }
}

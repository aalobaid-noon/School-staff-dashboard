SYNAPSE_BASE_URL=https://citadel.staging.noonedu.io   # staging; config, not a secret
SYNAPSE_APP_ID=
SYNAPSE_APP_SECRET=

# --- Sign in with Noon (end-user auth for the DEPLOYED app only) ---
# Both below are REQUIRED to deploy: without them the app fails closed (503) rather than serving
# Noon data unauthenticated. They're ignored in the workspace (the builder console stays open).
# Both are self-generated — no human has to hand you a value. Login itself runs on Citadel's own
# OAuth flow using SYNAPSE_APP_ID/SECRET above; the only manual step is registering the redirect
# URI in the Citadel portal (Replit Apps → your app → redirect URI; exact match, https required).
APP_OAUTH_REDIRECT_URI=https://<deployed>.replit.app/oauth/callback   # must exactly match the URI registered in the portal; config
APP_SESSION_SECRET=                                    # secret you mint yourself (e.g. `openssl rand -hex 32`); HMAC-signs the session + state cookies
